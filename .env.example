# Copy this file to .env.local and fill in real values.
# See README.md "Getting your API keys" for direct links to where each one is generated.

# --- Database (Supabase via Vercel integration) ---
# Vercel injects these automatically when Supabase is connected.
# POSTGRES_PRISMA_URL is the Prisma/serverless pooled runtime connection.
POSTGRES_PRISMA_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
# POSTGRES_URL_NON_POOLING is used for Prisma migrations/direct operations.
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/dbname"

# --- Redis (for background job queue — Upstash or Railway) ---
REDIS_URL="redis://default:password@host:6379"

# --- App ---
NEXTAUTH_SECRET="generate-a-random-32-char-string"
APP_URL="http://localhost:3000"
ENCRYPTION_KEY="generate-a-random-32-char-string" # used to encrypt tokens at rest

# --- Shopify Partner App ---
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_orders,read_products"

# --- QuickBooks Online (Intuit Developer App) ---
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_ENVIRONMENT="sandbox" # sandbox | production

# --- Stripe (billing) ---
# Secret and webhook values belong only in the deployment environment.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Live recurring price IDs created for the SyncStock catalog on 2026-09-08.
STRIPE_PRICE_STARTER="price_1UDWQwDuL2L3Le8ejIdEInlK"
STRIPE_PRICE_GROWTH="price_1UDWR1DuL2L3Le8e8f9VNSfF"
STRIPE_PRICE_UNLIMITED="price_1UDWR9DuL2L3Le8e95nD2wff"
