# Copy this file to .env.local and fill in real values.
# See README.md "Getting your API keys" for direct links to where each one is generated.

# --- Database (Supabase, Railway, or Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Redis (for background job queue — Upstash or Railway) ---
REDIS_URL="redis://default:password@host:6379"

# --- App ---
NEXTAUTH_SECRET="generate-a-random-32-char-string"
APP_URL="http://localhost:3000"
ENCRYPTION_KEY="generate-a-random-32-char-string" # used to encrypt tokens at rest

# --- Shopify Partner App ---
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_orders,read_products"

# --- QuickBooks Online (Intuit Developer App) ---
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_ENVIRONMENT="sandbox" # sandbox | production

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_UNLIMITED=""
