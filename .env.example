# Copy this file to .env.local and fill in real values.
# See README.md "Getting your API keys" for direct links to where each one is generated.

# --- Database (Supabase via Vercel integration) ---
# Vercel injects these automatically when Supabase is connected.
# POSTGRES_PRISMA_URL is the Prisma/serverless pooled runtime connection.
POSTGRES_PRISMA_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
# POSTGRES_URL_NON_POOLING is used for Prisma migrations/direct operations.
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/dbname"

# --- Queue bridge / worker ---
# Vercel sends jobs over HTTPS to the Railway worker bridge.
QUEUE_BRIDGE_URL="https://your-worker.up.railway.app"
QUEUE_BRIDGE_SECRET="generate-a-random-48-plus-char-string"
# Railway worker only: private Redis connection inside the Railway project.
REDIS_URL="redis://:password@redis.railway.internal:6379"

# --- App ---
NEXTAUTH_SECRET="generate-a-random-32-char-string"
APP_URL="http://localhost:3000"
ENCRYPTION_KEY="generate-a-random-32-char-string" # used to encrypt tokens at rest

# --- Shopify Partner App ---
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_orders,read_products"

# --- QuickBooks Online (Intuit Developer App) ---
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_ENVIRONMENT="sandbox" # sandbox | production

# --- Stripe (billing) ---
# Secret and webhook values belong only in the deployment environment.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Public price IDs are maintained in src/lib/plans.ts; legacy STRIPE_PRICE_* values are not used.

# --- Isolated sandbox (web and worker) ---
# Set true only on the isolated test pair, never on the existing live app.
SYNCSTOCK_SANDBOX="false"
# Sandbox web: public half of its worker's unique Ed25519 keypair, PEM encoded as base64.
WORKER_SIGNING_PUBLIC_KEY_B64=""
# Worker only: private half. Never put this on the web app or in source control.
WORKER_SIGNING_PRIVATE_KEY_B64=""
