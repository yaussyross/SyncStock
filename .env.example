# Copy this file to .env.local and fill in real values.
# Never commit real production credentials.

# --- Database (Supabase via Vercel integration) ---
# Vercel injects these automatically when Supabase is connected.
POSTGRES_PRISMA_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/dbname"

# --- Queue bridge / worker ---
QUEUE_BRIDGE_URL="https://your-worker.up.railway.app"
QUEUE_BRIDGE_SECRET="generate-a-random-48-plus-char-string"
# Railway worker only: private Redis connection inside the Railway project.
REDIS_URL="redis://:password@redis.railway.internal:6379"

# --- App ---
NEXTAUTH_SECRET="generate-a-random-32-char-string"
APP_URL="http://localhost:3000"
ENCRYPTION_KEY="generate-a-random-32-char-string"

# --- Shopify public app ---
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_orders,read_products"
# App Pricing / Partner API. Configure these only after the production app is
# registered for public distribution. The Partner API token needs Manage apps.
SHOPIFY_APP_HANDLE=""
SHOPIFY_APP_GID="gid://shopify/App/123456789"
SHOPIFY_PARTNER_ORG_ID=""
SHOPIFY_PARTNER_API_ACCESS_TOKEN=""

# --- QuickBooks Online (Intuit Developer App) ---
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_ENVIRONMENT="sandbox" # sandbox | production

# --- Billing ---
# New Shopify merchant subscriptions use Shopify App Pricing. Keep the legacy
# Stripe credentials only while migrating/cancelling any existing Stripe users.
# BILLING_PROVIDER="stripe_legacy" # DO NOT set for new public Shopify billing.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Historical Stripe price IDs remain in src/lib/plans.ts only for legacy records/tests.

# --- Isolated sandbox (web and worker) ---
# Set true only on the isolated test pair, never on the existing live app.
SYNCSTOCK_SANDBOX="false"
WORKER_SIGNING_PUBLIC_KEY_B64=""
WORKER_SIGNING_PRIVATE_KEY_B64=""
