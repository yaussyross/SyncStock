FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-15 redis-server ca-certificates openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN ENCRYPTION_KEY=build-placeholder NEXTAUTH_SECRET=build-placeholder STRIPE_SECRET_KEY=sk_test_build_placeholder NEXT_TELEMETRY_DISABLED=1 npm run build
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
CMD ["node", "scripts/sandbox/start.mjs"]
