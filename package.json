{
  "name": "syncstock",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "test:reconciliation": "tsx scripts/reconciliation-smoke.ts",
    "test:core": "tsx scripts/core-smoke.ts",
    "test:shopify-billing": "tsx scripts/shopify-billing-smoke.ts",
    "test:shopify-auth": "tsx scripts/shopify-id-token-smoke.ts",
    "test:shopify-errors": "tsx scripts/shopify-error-parser-smoke.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test:billing": "tsx scripts/billing-smoke.ts",
    "test:launch-surface": "tsx scripts/launch-surface-smoke.ts",
    "test:group:accounting": "npm run test:reconciliation && npm run test:core && npm run test:billing",
    "test:group:embedded": "npm run test:shopify-billing && npm run test:shopify-auth && npm run test:shopify-errors && npx tsx scripts/mapping-selection-smoke.ts && npm run test:qbo-reconnect && npm run test:qbo-return-handle && npm run test:embedded-retry && npm run test:embedded-sync-recovery",
    "test:group:public": "npm run test:launch-surface && npm run build",
    "test:launch-groups": "npm run test:group:accounting && npm run test:group:embedded && npm run test:group:public",
    "test:qbo-reconnect": "tsx scripts/qbo-reconnect-smoke.ts",
    "test:qbo-return-handle": "tsx scripts/qbo-return-handle-smoke.ts",
    "test:embedded-retry": "tsx scripts/embedded-retry-smoke.ts",
    "test:embedded-sync-recovery": "tsx scripts/embedded-sync-recovery-smoke.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@vercel/oidc": "^3.8.7",
    "bullmq": "^5.13.2",
    "intuit-oauth": "^4.1.0",
    "ioredis": "^5.4.1",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "next": "15.5.24",
    "node-quickbooks": "^2.0.44",
    "prisma": "^5.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^16.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
