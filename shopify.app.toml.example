# Copy to shopify.app.toml when the production domain and Shopify app client ID are finalized.
# Do not commit secrets. Shopify client_id is public app metadata, but keep environment-specific
# configuration deliberate rather than guessing it in this repository.

name = "SyncStock"
client_id = "REPLACE_WITH_SHOPIFY_CLIENT_ID"
application_url = "https://REPLACE_WITH_PRODUCTION_DOMAIN"
embedded = false

[access_scopes]
scopes = "read_orders,read_products"

[auth]
redirect_urls = [
  "https://REPLACE_WITH_PRODUCTION_DOMAIN/api/auth/shopify/callback"
]

[webhooks]
api_version = "2026-07"

[[webhooks.subscriptions]]
compliance_topics = ["customers/data_request", "customers/redact", "shop/redact"]
uri = "/api/webhooks/shopify/compliance"
